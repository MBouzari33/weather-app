<Window x:Class="WeatherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Weatherly" Height="620" Width="920" MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterScreen" Background="#0B1220"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#172033"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F8FAFC"/>
        </Style>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="#202B40"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="ResultPanel" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasResult}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ErrorPanel" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#111B31" Offset="0"/>
                <GradientStop Color="#07101F" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid Margin="54,42">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="WEATHERLY" Foreground="{StaticResource AccentBrush}"
                           FontSize="13" FontWeight="SemiBold" CharacterSpacing="180"/>
                <TextBlock Text="Your weather, at a glance." FontSize="34"
                           FontWeight="SemiBold" Margin="0,8,0,4"/>
                <TextBlock Text="Search any city for current conditions."
                           Foreground="{StaticResource MutedBrush}" FontSize="15"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,30,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                        BorderBrush="#2D3B55" BorderThickness="1">
                    <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Enter a city name" AutomationProperties.Name="City"
                             Background="Transparent" BorderThickness="0" Foreground="White"
                             CaretBrush="White" FontSize="16" Padding="18,14"/>
                </Border>
                <Button Grid.Column="1" Content="Search" Command="{Binding SearchCommand}"
                        AutomationProperties.Name="Search weather" IsDefault="True"
                        Margin="12,0,0,0" Padding="28,13" FontSize="15" FontWeight="SemiBold"
                        Foreground="#07101F" Background="{StaticResource AccentBrush}"
                        BorderThickness="0" Cursor="Hand"/>
            </Grid>

            <Grid Grid.Row="2">
                <TextBlock Text="Enter a city to see the latest conditions."
                           Foreground="{StaticResource MutedBrush}" FontSize="17"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasResult}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Fetching current conditions…" FontSize="17"
                               Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>

                <Grid Style="{StaticResource ResultPanel}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding LocationName}" FontSize="25" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Description}" FontSize="18"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding TemperatureDisplay}"
                                   FontSize="68" FontWeight="Light" Foreground="{StaticResource AccentBrush}"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,32,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="FEELS LIKE" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding FeelsLikeDisplay}" FontSize="22" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="HUMIDITY" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding HumidityDisplay}" FontSize="22" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource MetricCard}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="CONDITIONS" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding Condition}" FontSize="22" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Row="3" Style="{StaticResource ErrorPanel}" Background="#3A1D2B"
                    BorderBrush="#FB7185" BorderThickness="1" CornerRadius="10" Padding="14">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FDA4AF" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Grid>
</Window>